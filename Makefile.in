prefix		:= @prefix@
abs_top_srcdir	:= @abs_top_srcdir@
XLEN            := @XLEN@
RISCVTOOLS      := @RISCVTOOLS@
ROCC = examples
RUNNER         := "spike --extension=gemmini "

# Several public forwarding targets intentionally share build/bareMetalC.
# Serialize only this top-level dispatcher; each recursive make still uses the
# jobserver for parallel compilation inside its own output directory.
.NOTPARALLEL:

.PHONY: all bareMetalC clean imagenet transformers mlps \
	vpu-baremetal vpu-linux vpu-pk \
	vpu-perf-baremetal vpu-perf-linux vpu-perf-pk \
	fusion-vpu-baremetal fusion-vpu-linux fusion-vpu-pk \
	fusion-vpu-perf-baremetal fusion-vpu-perf-linux fusion-vpu-perf-pk

# Keep the default out-of-tree layout identical to the legacy flow.
# VPU and fusion programs are built inside bareMetalC, never in a
# configuration-named sibling directory.
all: bareMetalC imagenet transformers mlps

vars = \
	abs_top_srcdir=$(abs_top_srcdir) \
	XLEN=$(XLEN) \
	PREFIX=$(ROCC)-$@ \
	src_dir=$(abs_top_srcdir)/$@ \
	RISCVTOOLS=$(RISCVTOOLS)

bareMetalC:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

vpu-baremetal vpu-linux vpu-pk \
vpu-perf-baremetal vpu-perf-linux vpu-perf-pk \
fusion-vpu-baremetal fusion-vpu-linux fusion-vpu-pk \
fusion-vpu-perf-baremetal fusion-vpu-perf-linux fusion-vpu-perf-pk:
	mkdir -p bareMetalC
	$(MAKE) -C bareMetalC -f $(abs_top_srcdir)/bareMetalC/Makefile \
		abs_top_srcdir=$(abs_top_srcdir) \
		src_dir=$(abs_top_srcdir)/bareMetalC \
		XLEN=$(XLEN) \
		PREFIX=$(ROCC)-bareMetalC \
		RISCVTOOLS=$(RISCVTOOLS) \
		$@

imagenet:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

transformers:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

mlps:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

clean:
	@if test -d bareMetalC; then $(MAKE) -C bareMetalC -f $(abs_top_srcdir)/bareMetalC/Makefile abs_top_srcdir=$(abs_top_srcdir) PREFIX=$(ROCC)-bareMetalC clean; fi
	@if test -d imagenet; then $(MAKE) -C imagenet -f $(abs_top_srcdir)/imagenet/Makefile abs_top_srcdir=$(abs_top_srcdir) PREFIX=$(ROCC)-imagenet clean; fi
	@if test -d transformers; then $(MAKE) -C transformers -f $(abs_top_srcdir)/transformers/Makefile abs_top_srcdir=$(abs_top_srcdir) PREFIX=$(ROCC)-transformers clean; fi
	@if test -d mlps; then $(MAKE) -C mlps -f $(abs_top_srcdir)/mlps/Makefile abs_top_srcdir=$(abs_top_srcdir) PREFIX=$(ROCC)-mlps clean; fi

test-baremetal-bareMetalC:
	make -C bareMetalC	\
	        -f $(abs_top_srcdir)/bareMetalC/Makefile \
                TARGET_MAKEFILE=$(abs_top_srcdir)/bareMetalC/Makefile \
		abs_top_srcdir=$(abs_top_srcdir) \
	 	src_dir=$(abs_top_srcdir)/bareMetalC \
	 	XLEN=$(XLEN) \
	 	PREFIX=$(ROCC)-bareMetalC \
		RISCVTOOLS=$(RISCVTOOLS) \
		RUNNER=$(RUNNER) \
		run-baremetal

test-baremetal: test-baremetal-bareMetalC
	make -C mlps	\
	        -f $(abs_top_srcdir)/mlps/Makefile \
                TARGET_MAKEFILE=$(abs_top_srcdir)/mlps/Makefile \
		abs_top_srcdir=$(abs_top_srcdir) \
	 	src_dir=$(abs_top_srcdir)/mlps \
	 	XLEN=$(XLEN) \
	 	PREFIX=$(ROCC)-mlps \
		RISCVTOOLS=$(RISCVTOOLS) \
		RUNNER=$(RUNNER) \
	        run-baremetal
	make -C imagenet	\
	        -f $(abs_top_srcdir)/imagenet/Makefile \
                TARGET_MAKEFILE=$(abs_top_srcdir)/imagenet/Makefile \
		abs_top_srcdir=$(abs_top_srcdir) \
	 	src_dir=$(abs_top_srcdir)/imagenet \
	 	XLEN=$(XLEN) \
	 	PREFIX=$(ROCC)-imagenet \
		RISCVTOOLS=$(RISCVTOOLS) \
		RUNNER=$(RUNNER) \
		run-baremetal
